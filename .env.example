# Local Docker Compose database
POSTGRES_DB=notifyhub
POSTGRES_USER=notifyhub
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432

# RabbitMQ local account and management UI
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Application security
# Generate a Base64-encoded secret with at least 32 random bytes.
JWT_SECRET=replace-with-a-base64-encoded-32-byte-secret
JWT_EXPIRATION_MS=3600000
APP_PORT=8080

# JPA is update for the local Docker stack. Use a migration tool before production deployments.
JPA_DDL_AUTO=update

# Optional SMTP provider, such as Mailtrap
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_FROM=no-reply@notifyhub.local
# Set true only when the configured SMTP server should be part of overall health.
MANAGEMENT_HEALTH_MAIL_ENABLED=false

# Frontend address permitted to connect to WebSocket endpoint
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5173
